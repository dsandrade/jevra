{
  "compilerOptions": {
    "target": "ES2023",
    "types": [
      "node"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/**/*.ts",
    "tests/**/*.ts",
    "evals/**/*.ts"
  ],
  "exclude": [
    "evals/local-results",
    "evals/captures",
    "node_modules",
    "dist"
  ]
}
